# Скопируйте в .env и заполните под свой backend
# Форма заявки (frontend-переменные, Vite; по умолчанию совпадают с путями backend)
VITE_REQUESTS_API_URL=/api/requests
# AI-консультант
VITE_AI_CHAT_URL=/api/chat

# --- Backend (FastAPI) ---
# Ключ polza.ai (OpenAI-совместимый API). НЕ коммитить!
AI_API_KEY=pza_REPLACE_ME
AI_BASE_URL=https://polza.ai/api/v1
AI_MODEL=openai/gpt-6-luna
# Таймаут вызова модели, секунд (фронтовой таймаут чата — 120 с)
AI_TIMEOUT_SECONDS=110
